#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56441cdec610 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56441cdec7a0 .scope module, "instr_mem_tb" "instr_mem_tb" 3 1;
 .timescale 0 0;
v0x56441ce3d420_0 .var "addr", 31 0;
v0x56441ce3d4e0_0 .net "instr", 31 0, L_0x56441ce3d7f0;  1 drivers
S_0x56441ce28ac0 .scope task, "check_read" "check_read" 3 10, 3 10 0, S_0x56441cdec7a0;
 .timescale 0 0;
v0x56441ce28ca0_0 .var "address", 31 0;
v0x56441ce3cb80_0 .var "expected", 31 0;
v0x56441ce3cc60_0 .var/str "msg";
TD_instr_mem_tb.check_read ;
    %load/vec4 v0x56441ce28ca0_0;
    %store/vec4 v0x56441ce3d420_0, 0, 32;
    %delay 1, 0;
    %load/vec4 v0x56441ce3d4e0_0;
    %load/vec4 v0x56441ce3cb80_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 14 "$error", "%s: esperado %h, obtido %h", v0x56441ce3cc60_0, v0x56441ce3cb80_0, v0x56441ce3d4e0_0 {0 0 0};
    %vpi_call/w 3 15 "$finish" {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 17 "$display", "PASS: %s -> %h", v0x56441ce3cc60_0, v0x56441ce3d4e0_0 {0 0 0};
T_0.1 ;
    %end;
S_0x56441ce3cd00 .scope module, "dut" "instr_mem" 3 5, 4 1 0, S_0x56441cdec7a0;
 .timescale 0 0;
    .port_info 0 /INPUT 32 "addr";
    .port_info 1 /OUTPUT 32 "instr";
L_0x56441ce3d7f0 .functor BUFZ 32, L_0x56441ce3d5b0, C4<00000000000000000000000000000000>, C4<00000000000000000000000000000000>, C4<00000000000000000000000000000000>;
v0x56441ce3cf00_0 .net *"_ivl_0", 31 0, L_0x56441ce3d5b0;  1 drivers
v0x56441ce3d000_0 .net *"_ivl_3", 29 0, L_0x56441ce3d6b0;  1 drivers
v0x56441ce3d0e0_0 .net "addr", 31 0, v0x56441ce3d420_0;  1 drivers
v0x56441ce3d1d0_0 .net "instr", 31 0, L_0x56441ce3d7f0;  alias, 1 drivers
v0x56441ce3d2b0 .array "mem", 255 0, 31 0;
L_0x56441ce3d5b0 .array/port v0x56441ce3d2b0, L_0x56441ce3d6b0;
L_0x56441ce3d6b0 .part v0x56441ce3d420_0, 2, 30;
    .scope S_0x56441ce3cd00;
T_1 ;
    %vpi_call/w 4 8 "$readmemh", "program.hex", v0x56441ce3d2b0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x56441cdec7a0;
T_2 ;
    %delay 1, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56441ce28ca0_0, 0, 32;
    %pushi/vec4 19, 0, 32;
    %store/vec4 v0x56441ce3cb80_0, 0, 32;
    %pushi/str "instr em addr 0";
    %store/str v0x56441ce3cc60_0;
    %fork TD_instr_mem_tb.check_read, S_0x56441ce28ac0;
    %join;
    %pushi/vec4 4, 0, 32;
    %store/vec4 v0x56441ce28ca0_0, 0, 32;
    %pushi/vec4 5244179, 0, 32;
    %store/vec4 v0x56441ce3cb80_0, 0, 32;
    %pushi/str "instr em addr 4";
    %store/str v0x56441ce3cc60_0;
    %fork TD_instr_mem_tb.check_read, S_0x56441ce28ac0;
    %join;
    %pushi/vec4 8, 0, 32;
    %store/vec4 v0x56441ce28ca0_0, 0, 32;
    %pushi/vec4 10487187, 0, 32;
    %store/vec4 v0x56441ce3cb80_0, 0, 32;
    %pushi/str "instr em addr 8";
    %store/str v0x56441ce3cc60_0;
    %fork TD_instr_mem_tb.check_read, S_0x56441ce28ac0;
    %join;
    %pushi/vec4 12, 0, 32;
    %store/vec4 v0x56441ce28ca0_0, 0, 32;
    %pushi/vec4 11535891, 0, 32;
    %store/vec4 v0x56441ce3cb80_0, 0, 32;
    %pushi/str "instr em addr 12";
    %store/str v0x56441ce3cc60_0;
    %fork TD_instr_mem_tb.check_read, S_0x56441ce28ac0;
    %join;
    %vpi_call/w 3 29 "$display", "Todos os testes da instr_mem passaram." {0 0 0};
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/instr_mem_tb.sv";
    "rtl/instr_mem.sv";
